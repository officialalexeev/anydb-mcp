{
  "name": "anydb-mcp",
  "version": "2.0.2",
  "description": "Universal database connector for AI agents (Cursor, Claude, Gemini, Zed, Cline). Zero-config MCP server for PostgreSQL, MySQL, SQLite, MongoDB, and Redis.",
  "type": "module",
  "main": "src/index.js",
  "exports": "./src/index.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "anydb-mcp": "src/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/officialalexeev/anydb-mcp.git"
  },
  "files": [
    "src/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/index.js",
    "test": "node ./node_modules/jest/bin/jest.js --config=jest.config.cjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "database",
    "db",
    "sql",
    "nosql",
    "postgres",
    "postgresql",
    "mysql",
    "mariadb",
    "sqlite",
    "sqlite3",
    "mongodb",
    "mongo",
    "redis",
    "ai",
    "llm",
    "agent",
    "tool",
    "cursor",
    "cursor-mcp",
    "zed",
    "zed-editor",
    "claude",
    "claude-desktop",
    "gemini",
    "gemini-cli",
    "google-gemini",
    "cline",
    "roo-cline",
    "vscode",
    "backend",
    "connector",
    "function-calling",
    "context"
  ],
  "author": "Alexeev Alexandr <officialalexeev@yandex.ru>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "mongodb": "^7.6.0",
    "mysql2": "^3.24.4",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2"
  },
  "allowScripts": {
    "sqlite3": true
  }
}
