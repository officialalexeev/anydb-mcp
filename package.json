{
  "name": "anydb-mcp",
  "version": "3.0.5",
  "description": "One MCP server for five databases — PostgreSQL, MySQL, SQLite, MongoDB and Redis — with named connection profiles, so database passwords never enter the model's context window.",
  "type": "module",
  "main": "src/lib.js",
  "exports": {
    ".": "./src/lib.js",
    "./server": "./src/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "anydb-mcp": "src/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/officialalexeev/anydb-mcp.git"
  },
  "homepage": "https://github.com/officialalexeev/anydb-mcp#readme",
  "bugs": {
    "url": "https://github.com/officialalexeev/anydb-mcp/issues"
  },
  "files": [
    "src/",
    "docs/",
    "!docs/build-and-publish.md",
    "!docs/publication_guide_ru.md",
    "examples/",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/index.js",
    "test": "node ./node_modules/jest/bin/jest.js --config=jest.config.cjs",
    "test:coverage": "node ./node_modules/jest/bin/jest.js --config=jest.config.cjs --coverage",
    "verify:package": "node scripts/verify-package.mjs",
    "prepublishOnly": "npm test && npm run verify:package"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "database",
    "db",
    "sql",
    "nosql",
    "postgres",
    "postgresql",
    "mysql",
    "mariadb",
    "sqlite",
    "sqlite3",
    "mongodb",
    "mongo",
    "redis",
    "ai",
    "llm",
    "agent",
    "tool",
    "cursor",
    "cursor-mcp",
    "zed",
    "zed-editor",
    "claude",
    "claude-desktop",
    "gemini",
    "gemini-cli",
    "google-gemini",
    "cline",
    "roo-cline",
    "vscode",
    "backend",
    "connector",
    "function-calling",
    "context"
  ],
  "author": "Alexeev Alexandr <officialalexeev@yandex.ru>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "mongodb": "^7.6.0",
    "mysql2": "^3.24.4",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2"
  }
}
